{
  "name": "frankenstein-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.js",
    "emulators": "firebase emulators:start --project demo-frankenstein --only auth,database",
    "dev:emulator": "vite --host 0.0.0.0 --mode emulator",
    "test:firebase": "node --test test/integration/firebase.test.mjs",
    "test:emulator": "firebase emulators:exec --project demo-frankenstein --only database \"npm run test:firebase\""
  },
  "dependencies": {
    "firebase": "13.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.37.0",
    "prettier": "3.10.1",
    "vite": "7.3.8"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
